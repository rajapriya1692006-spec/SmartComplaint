# Copy this file to .env and fill in values for your local environment.
# Required backend settings
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/smartcomplaint
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CLIENT_URL=http://localhost:5173,http://localhost:5174

# Local AI (optional; fallback mode is used if Ollama is unavailable)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# SMTP notifications (optional). Use 465 for implicit TLS or 587 for STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Optional demo-account creation values; never use shared production passwords.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
STAFF_NAME=
STAFF_EMAIL=
STAFF_PASSWORD=
STAFF_DEPARTMENT=Finance Support
